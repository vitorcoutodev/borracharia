# Copie este arquivo para .env e preencha (o .env NUNCA vai para o GitHub)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/borracharia?retryWrites=true&w=majority
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio
ADMIN_USER=rogerio
ADMIN_PASS=troque-esta-senha
NOME_SISTEMA=Borracharia do Rogério

# Chave PIX que vai nas cobranças (CNPJ)
PIX_CHAVE=60858425000168
# WhatsApp oficial (guia em WHATSAPP.md). Deixe vazio para usar só os botões manuais.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Redefinição de senha por e-mail (Resend, grátis). ADMIN_EMAIL = e-mail da conta Resend, enquanto não houver domínio verificado.
ADMIN_EMAIL=
RESEND_API_KEY=
# Endereço público do site (usado nos links dos e-mails), ex.: https://rogerio-pneus.onrender.com
SITE_URL=
