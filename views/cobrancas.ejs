<%- include('topo') %>
<div class="linha"><h1>Cobranças</h1><strong><%= dinheiro(total) %></strong></div>
<div class="card lista">
  <% if (!lista.length) { %><p class="mudo">Nenhum valor pendente. </p><% } %>
  <% lista.forEach(a => { if (!a.cliente) return; %>
  <div class="item col">
    <div>
      <a href="/clientes/<%= a.cliente._id %>"><strong><%= a.cliente.nome %></strong></a><br>
      <%= a.servico %><br>
      <strong><%= dinheiro(a.valor) %></strong> · <small><%= data(a.createdAt) %></small>
    </div>
    <div class="linha">
      <a class="btn zap" target="_blank" rel="noopener" href="<%= waLink(a.cliente.telefone, 'Olá ' + a.cliente.nome + ', tudo bem? Passando para lembrar do valor pendente de ' + dinheiro(a.valor) + ' referente a ' + a.servico + ' (' + data(a.createdAt) + '). Qualquer dúvida é só falar!') %>">COBRAR</a>
      <form method="post" action="/atendimentos/<%= a._id %>/pagar" class="linha" data-confirm="Marcar como pago?">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <select name="forma"><option value="pix">PIX</option><option value="dinheiro">Dinheiro</option><option value="cartao">Cartão</option><option value="outro">Outro</option></select>
        <button class="btn sec">Recebido</button>
      </form>
    </div>
  </div>
  <% }) %>
</div>
<%- include('rodape') %>
