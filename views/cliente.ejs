<%- include('topo') %>
<% const s = statusPlano(c); %>
<div class="linha">
  <h1><%= c.nome %> <% if (!c.ativo) { %><span class="tag cinza">inativo</span><% } %></h1>
</div>
<p><%= c.telefone %></p>
<div class="acoes">
  <a class="btn" href="/atendimentos/novo?cliente=<%= c._id %>">+ Novo atendimento</a>
  <a class="btn zap" target="_blank" rel="noopener" href="<%= waLink(c.telefone, 'Olá ' + c.nome + '!') %>">WhatsApp</a>
  <a class="btn sec" href="/clientes/<%= c._id %>/editar">Editar</a>
  <form method="post" action="/clientes/<%= c._id %>/ativar" data-confirm="<%= c.ativo ? 'Desativar este cliente?' : 'Reativar este cliente?' %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sec"><%= c.ativo ? 'Desativar' : 'Reativar' %></button>
  </form>
</div>

<% if (pendente > 0) { %><div class="alerta aviso">Valor em aberto: <strong><%= dinheiro(pendente) %></strong></div><% } %>

<h2>Plano</h2>
<div class="card">
  <% if (s) { const pl = c.plano.plano; %>
    <p><strong><%= pl ? pl.nome : 'Plano' %></strong><%= pl ? ' - ' + dinheiro(pl.preco) + '/mês' : '' %> <span class="tag <%= s.tipo %>"><%= s.tipo === 'vencido' ? 'vencido' : s.tipo === 'vencendo' ? 'vence em ' + s.dias + ' dia(s)' : 'ativo' %></span><br>
    <small>Início <%= data(c.plano.inicio) %> - Vencimento <%= data(c.plano.vencimento) %></small></p>
    <% if (saldo) { %>
    <div class="lista">
      <% saldo.forEach(i => { %><div class="item"><span><%= i.nome %></span><span><strong><%= i.resta %></strong> restante(s) <small>(usou <%= i.usado %> de <%= i.total %>)</small></span></div><% }) %>
    </div>
    <% } else { %><p class="mudo">Plano vencido. Renove para liberar os serviços.</p><% } %>
    <p>Termo: <span class="tag <%= c.plano.termo === 'aceito' ? 'ativo' : c.plano.termo === 'recusado' ? 'vencido' : 'vencendo' %>"><%= c.plano.termo === 'aceito' ? 'aceito' : c.plano.termo === 'recusado' ? 'recusado' : 'aguardando resposta' %></span></p>
    <div class="acoes">
      <% if (waApi) { %><form method="post" action="/clientes/<%= c._id %>/termo-api"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn zap">Enviar termo (API)</button></form><% } %>
      <a class="btn <%= waApi ? 'sec' : 'zap' %>" target="_blank" rel="noopener" href="<%= waLink(c.telefone, termoMsg) %>">Enviar termo<%= waApi ? ' (manual)' : '' %></a>
      <form method="post" action="/clientes/<%= c._id %>/termo"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="aceito"><button class="btn sec">Cliente aceitou</button></form>
      <form method="post" action="/clientes/<%= c._id %>/termo"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="recusado"><button class="btn sec">Cliente recusou</button></form>
    </div>
  <% } else { %><p class="mudo">Sem plano.</p><% } %>
  <form method="post" action="/clientes/<%= c._id %>/plano" class="linha">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <select name="plano">
      <option value="">Sem plano</option>
      <% planos.forEach(p => { %><option value="<%= p._id %>" <%= c.plano && c.plano.plano && String(c.plano.plano._id) === String(p._id) ? 'selected' : '' %>><%= p.nome %> (<%= dinheiro(p.preco) %>)</option><% }) %>
    </select>
    <button class="btn">Ativar / Renovar</button>
  </form>
</div>

<h2>Veículos</h2>
<div class="card lista">
  <% c.veiculos.forEach(v => { %>
  <div class="item"><span><%= v.modelo %> <small><%= v.placa || '' %></small></span>
    <form method="post" action="/clientes/<%= c._id %>/veiculos/<%= v._id %>/remover" data-confirm="Remover este veículo?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn peq sec">Remover</button></form></div>
  <% }) %>
  <form method="post" action="/clientes/<%= c._id %>/veiculos" class="linha">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input name="modelo" placeholder="Modelo" maxlength="80" required>
    <input name="placa" placeholder="Placa" maxlength="10">
    <button class="btn peq">Adicionar</button>
  </form>
</div>

<h2>Histórico</h2>
<div class="card lista">
  <% if (!historico.length) { %><p class="mudo">Nenhum atendimento ainda.</p><% } %>
  <% historico.forEach(a => { %>
  <div class="item">
    <div>
      <small><%= data(a.createdAt) %><%= a.veiculo ? ' · ' + a.veiculo : '' %></small><br>
      <strong><%= a.servico %></strong><br>
      <%= dinheiro(a.valor) %><%= a.forma ? ' · ' + a.forma.toUpperCase() : '' %>
      <% if (a.obs) { %><br><small><%= a.obs %></small><% } %>
      <% if (a.foto) { %><br><a href="/img/<%= a.foto %>" target="_blank" rel="noopener"><img class="mini" src="/img/<%= a.foto %>" alt="Foto do serviço" loading="lazy"></a>
      <% } else { %><form method="post" action="/atendimentos/<%= a._id %>/foto?_csrf=<%= csrf %>" enctype="multipart/form-data"><input type="file" name="foto" accept="image/*" data-auto></form><% } %>
    </div>
    <div class="dir">
      <span class="tag <%= a.pago ? 'ativo' : 'vencido' %>"><%= a.pago ? 'Pago' : 'Pendente' %></span>
      <% if (!a.pago) { %><a class="btn peq zap" target="_blank" rel="noopener" href="<%= waLink(c.telefone, 'Olá ' + c.nome + ', tudo bem? Passando para lembrar do valor pendente de ' + dinheiro(a.valor) + ' referente a ' + a.servico + ' (' + data(a.createdAt) + '). Chave PIX (CNPJ): ' + pix + '. Qualquer dúvida é só falar!') %>">Cobrar</a><% } %>
    </div>
  </div>
  <% }) %>
</div>
<%- include('rodape') %>
