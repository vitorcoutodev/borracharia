<%- include('topo') %>
<div class="card login">
  <img class="logo-login" src="/logo.png" alt=""><h1><%= nomeSistema %></h1><p class="mudo"><%= subtitulo %></p>
  <% if (erro) { %><div class="alerta erro"><%= erro %></div><% } %>
  <form method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Usuário <input name="usuario" autocomplete="username" autocapitalize="none" required autofocus></label>
    <label>Senha <input type="password" name="senha" autocomplete="current-password" required></label>
    <button class="btn grande">Entrar</button>
  </form>
  <p><a href="/esqueci">Esqueci minha senha</a></p>
</div>
<%- include('rodape') %>
