<%- include('topo') %>
<h1>Enviar promoção</h1>
<div class="card">
  <% if (promo.imagem) { %><img class="prev" src="/img/<%= promo.imagem %>" alt=""><% } %>
  <p class="pre"><%= promo.texto %></p>
</div>
<button class="btn grande" data-compartilhar data-texto="<%= promo.texto %>" data-img="<%= promo.imagem ? '/img/' + promo.imagem : '' %>">Compartilhar com imagem (celular)</button>
<% if (waApi) { %>
  <% if (promo.envio && promo.envio.total) { %><div class="alerta ok">Envio pela API: <%= promo.envio.ok %> enviados, <%= promo.envio.falhas %> falhas, de <%= promo.envio.total %><%= promo.envio.andamento ? ' (em andamento, atualize a página)' : '' %></div><% } %>
  <form method="post" action="/promocao/<%= promo._id %>/enviar-todos" data-confirm="Enviar para <%= lista.length %> clientes? Cada mensagem é cobrada pela Meta.">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sec grande">Enviar para todos pela API (<%= lista.length %> clientes)</button>
  </form>
<% } %>
<input class="card" data-filtro type="search" placeholder="Buscar cliente">
<div class="card lista">
  <% if (!lista.length) { %><p class="mudo">Nenhum cliente cadastrado.</p><% } %>
  <% lista.forEach(c => { %>
  <div class="item" data-nome="<%= (c.nome + ' ' + c.telefone).toLowerCase() %>">
    <span><%= c.nome %> <small><%= c.telefone %></small></span>
    <% if (waApi) { %>
    <form method="post" action="/promocao/<%= promo._id %>/enviar/<%= c._id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn peq zap">Enviar com imagem</button></form>
    <% } else { %>
    <a class="btn peq zap" data-zap target="_blank" rel="noopener" href="<%= waLink(c.telefone, promo.texto + '\n\n' + url) %>">Enviar</a>
    <% } %>
  </div>
  <% }) %>
</div>
<%- include('rodape') %>
